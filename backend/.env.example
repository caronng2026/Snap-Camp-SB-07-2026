# Copy to .env and fill in. .env is gitignored and must never be committed.
# The Atlas connection string carries credentials inline — treat it as a secret.

# --- Data ---
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB=snapcamp
SESSION_SECRET=<a long random string>

# --- Networking ---
# Where this process listens. 127.0.0.1 is correct for local development.
# A deployed host almost always needs 0.0.0.0 so the platform can route to it.
HOST=127.0.0.1
PORT=3000

# The public URL this backend is reachable at. Fill in once the live URL exists.
PUBLIC_URL=http://localhost:3000

# The origin the browser app is served from.
#
# Leave this EQUAL to PUBLIC_URL for the approved deployment, where this server
# also serves the built frontend. That is the same-origin model recorded in
# precode/ARCHITECTURE.md: the session cookie is sent automatically and there is
# no CORS configuration anywhere in the codebase.
#
# Setting a DIFFERENT origin here does not work with the current code. The browser
# would not send the session cookie cross-site, so every request would come back
# 401. Making it work needs CORS with credentials plus a SameSite=None; Secure
# cookie, neither of which is implemented. The server says so loudly at startup if
# these two disagree, rather than appearing to run correctly.
FRONTEND_ORIGIN=http://localhost:3000
