# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Vite only exposes variables prefixed with VITE_ to the browser. Anything here is
# readable by anyone using the app, so this file must never hold a secret. The
# session secret and the Atlas connection string belong in backend/.env only.

# Base URL the app sends its API requests to.
#
# EMPTY is the approved setting and the one that works today. Requests go to
# relative paths like /api/log/2026-08-04, which means:
#   - in development, the Vite dev server proxies /api to the backend
#   - in production, the backend serves this built app, so it is already same-origin
# Either way the session cookie is sent automatically and no CORS is involved.
#
# Set an absolute URL here (e.g. https://api.example.com) only if the app is served
# from a DIFFERENT origin than the backend. That is not supported by the current
# code: the browser will not send the session cookie cross-site, so requests will
# 401. It needs CORS with credentials on the backend and a SameSite=None; Secure
# cookie first. Leave empty until that exists.
VITE_API_BASE_URL=
